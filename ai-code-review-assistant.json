{
  "name": "AI Code Review Assistant",
  "nodes": [
    {
      "id": "d4e5f6a7-0004-4000-8000-400000000001",
      "name": "GitHub PR Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "github-pr-review",
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "ai-code-review-webhook"
    },
    {
      "id": "d4e5f6a7-0004-4000-8000-400000000002",
      "name": "Filter PR Opened",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.body.action }}",
              "rightValue": "opened",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "d4e5f6a7-0004-4000-8000-400000000003",
      "name": "Fetch PR Diff",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [720, 200],
      "parameters": {
        "method": "GET",
        "url": "={{ $('GitHub PR Webhook').item.json.body.pull_request.diff_url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": { "id": "5", "name": "GitHub Token Header" }
      }
    },
    {
      "id": "d4e5f6a7-0004-4000-8000-400000000004",
      "name": "Review with OpenAI",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [960, 200],
      "parameters": {
        "operation": "message",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o",
          "mode": "list",
          "cachedResultName": "gpt-4o"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are an experienced software engineer conducting a code review. Analyze the provided git diff and provide constructive feedback. Structure your review as:\n\n## Summary\nBrief overview of the changes.\n\n## Issues Found\nList any bugs, security concerns, or logic errors (if none, say \"No critical issues found\").\n\n## Suggestions\nStyle, performance, or readability improvements.\n\n## Verdict\nOne of: APPROVE / REQUEST_CHANGES / COMMENT"
            },
            {
              "role": "user",
              "content": "=Please review this pull request diff:\n\nPR Title: {{ $('GitHub PR Webhook').item.json.body.pull_request.title }}\nAuthor: {{ $('GitHub PR Webhook').item.json.body.pull_request.user.login }}\n\nDiff:\n{{ $json.data.substring(0, 8000) }}"
            }
          ]
        },
        "options": {
          "maxTokens": 1000,
          "temperature": 0.2
        }
      },
      "credentials": {
        "openAiApi": { "id": "2", "name": "OpenAI Account" }
      }
    },
    {
      "id": "d4e5f6a7-0004-4000-8000-400000000005",
      "name": "Post GitHub Review Comment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1200, 200],
      "parameters": {
        "method": "POST",
        "url": "={{ $('GitHub PR Webhook').item.json.body.pull_request.comments_url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "body": {
          "body": "={{ '## AI Code Review\\n\\n' + $json.message.content + '\\n\\n---\\n*Review generated by AI Code Review Assistant*' }}"
        }
      },
      "credentials": {
        "httpHeaderAuth": { "id": "5", "name": "GitHub Token Header" }
      }
    }
  ],
  "connections": {
    "GitHub PR Webhook": {
      "main": [
        [{ "node": "Filter PR Opened", "type": "main", "index": 0 }]
      ]
    },
    "Filter PR Opened": {
      "main": [
        [{ "node": "Fetch PR Diff", "type": "main", "index": 0 }],
        []
      ]
    },
    "Fetch PR Diff": {
      "main": [
        [{ "node": "Review with OpenAI", "type": "main", "index": 0 }]
      ]
    },
    "Review with OpenAI": {
      "main": [
        [{ "node": "Post GitHub Review Comment", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true
  }
}
