{
  "name": "AI Content Classifier",
  "nodes": [
    {
      "id": "c3d4e5f6-0003-4000-8000-300000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "classify-content",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "ai-content-classifier-webhook"
    },
    {
      "id": "c3d4e5f6-0003-4000-8000-300000000002",
      "name": "Classify with OpenAI",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [480, 300],
      "parameters": {
        "operation": "message",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a content classification API. Given a text input, respond ONLY with a valid JSON object (no markdown, no code fences) containing exactly these fields:\n- \"topic\": one of [\"technology\", \"business\", \"health\", \"politics\", \"entertainment\", \"sports\", \"science\", \"other\"]\n- \"sentiment\": one of [\"positive\", \"neutral\", \"negative\"]\n- \"confidence\": a number between 0 and 1\n- \"summary\": a one-sentence description of the content"
            },
            {
              "role": "user",
              "content": "={{ $json.body.text }}"
            }
          ]
        },
        "options": {
          "maxTokens": 200,
          "temperature": 0
        }
      },
      "credentials": {
        "openAiApi": { "id": "2", "name": "OpenAI Account" }
      }
    },
    {
      "id": "c3d4e5f6-0003-4000-8000-300000000003",
      "name": "Parse Classification",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [720, 300],
      "parameters": {
        "mode": "manual",
        "fields": {
          "values": [
            {
              "name": "classification",
              "type": "object",
              "value": "={{ JSON.parse($json.message.content) }}"
            },
            {
              "name": "inputText",
              "type": "string",
              "value": "={{ $('Webhook').item.json.body.text }}"
            },
            {
              "name": "processedAt",
              "type": "string",
              "value": "={{ new Date().toISOString() }}"
            }
          ]
        }
      }
    },
    {
      "id": "c3d4e5f6-0003-4000-8000-300000000004",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [960, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, data: $json }) }}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [{ "node": "Classify with OpenAI", "type": "main", "index": 0 }]
      ]
    },
    "Classify with OpenAI": {
      "main": [
        [{ "node": "Parse Classification", "type": "main", "index": 0 }]
      ]
    },
    "Parse Classification": {
      "main": [
        [{ "node": "Respond to Webhook", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true
  }
}
