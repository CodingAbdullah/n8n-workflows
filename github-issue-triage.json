{
  "name": "GitHub Issue Triage",
  "nodes": [
    {
      "id": "a7b8c9d0-0007-4000-8000-700000000001",
      "name": "GitHub Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "github-issue-triage",
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "github-issue-triage-webhook"
    },
    {
      "id": "a7b8c9d0-0007-4000-8000-700000000002",
      "name": "Filter Issue Opened",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.body.action }}",
              "rightValue": "opened",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "a7b8c9d0-0007-4000-8000-700000000003",
      "name": "Suggest Labels with OpenAI",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [720, 200],
      "parameters": {
        "operation": "message",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a GitHub issue triaging assistant. Given an issue title and body, respond ONLY with a valid JSON object (no markdown, no code fences) with exactly these fields:\n- \"labels\": array of 1-3 strings chosen from [\"bug\", \"enhancement\", \"documentation\", \"question\", \"performance\", \"security\", \"good first issue\", \"help wanted\", \"duplicate\", \"wontfix\"]\n- \"priority\": one of [\"critical\", \"high\", \"medium\", \"low\"]\n- \"summary\": one sentence description of the issue"
            },
            {
              "role": "user",
              "content": "=Title: {{ $('GitHub Webhook').item.json.body.issue.title }}\n\nBody:\n{{ $('GitHub Webhook').item.json.body.issue.body ?? 'No description provided.' }}"
            }
          ]
        },
        "options": {
          "maxTokens": 200,
          "temperature": 0
        }
      },
      "credentials": {
        "openAiApi": { "id": "2", "name": "OpenAI Account" }
      }
    },
    {
      "id": "a7b8c9d0-0007-4000-8000-700000000004",
      "name": "Parse Triage Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [960, 200],
      "parameters": {
        "mode": "manual",
        "fields": {
          "values": [
            {
              "name": "triage",
              "type": "object",
              "value": "={{ JSON.parse($json.message.content) }}"
            },
            {
              "name": "issueNumber",
              "type": "number",
              "value": "={{ $('GitHub Webhook').item.json.body.issue.number }}"
            },
            {
              "name": "repoOwner",
              "type": "string",
              "value": "={{ $('GitHub Webhook').item.json.body.repository.owner.login }}"
            },
            {
              "name": "repoName",
              "type": "string",
              "value": "={{ $('GitHub Webhook').item.json.body.repository.name }}"
            }
          ]
        }
      }
    },
    {
      "id": "a7b8c9d0-0007-4000-8000-700000000005",
      "name": "Apply Labels via GitHub API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1200, 200],
      "parameters": {
        "method": "POST",
        "url": "=https://api.github.com/repos/{{ $json.repoOwner }}/{{ $json.repoName }}/issues/{{ $json.issueNumber }}/labels",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "body": {
          "labels": "={{ $json.triage.labels }}"
        }
      },
      "credentials": {
        "httpHeaderAuth": { "id": "5", "name": "GitHub Token Header" }
      }
    }
  ],
  "connections": {
    "GitHub Webhook": {
      "main": [
        [{ "node": "Filter Issue Opened", "type": "main", "index": 0 }]
      ]
    },
    "Filter Issue Opened": {
      "main": [
        [{ "node": "Suggest Labels with OpenAI", "type": "main", "index": 0 }],
        []
      ]
    },
    "Suggest Labels with OpenAI": {
      "main": [
        [{ "node": "Parse Triage Result", "type": "main", "index": 0 }]
      ]
    },
    "Parse Triage Result": {
      "main": [
        [{ "node": "Apply Labels via GitHub API", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true
  }
}
