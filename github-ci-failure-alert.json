{
  "name": "GitHub CI Failure Alert",
  "nodes": [
    {
      "id": "f6a7b8c9-0006-4000-8000-600000000001",
      "name": "GitHub Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "github-ci-failure",
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "github-ci-failure-webhook"
    },
    {
      "id": "f6a7b8c9-0006-4000-8000-600000000002",
      "name": "Check Workflow Completed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.body.action }}",
              "rightValue": "completed",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "f6a7b8c9-0006-4000-8000-600000000003",
      "name": "Check Run Failed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 200],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.body.workflow_run.conclusion }}",
              "rightValue": "failure",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "f6a7b8c9-0006-4000-8000-600000000004",
      "name": "Build Alert Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [960, 200],
      "parameters": {
        "mode": "manual",
        "fields": {
          "values": [
            {
              "name": "alertText",
              "type": "string",
              "value": "=:red_circle: *CI Failure*\n*Workflow:* {{ $('GitHub Webhook').item.json.body.workflow_run.name }}\n*Branch:* `{{ $('GitHub Webhook').item.json.body.workflow_run.head_branch }}`\n*Commit:* `{{ $('GitHub Webhook').item.json.body.workflow_run.head_sha.substring(0, 7) }}` — {{ $('GitHub Webhook').item.json.body.workflow_run.head_commit.message.split('\\n')[0] }}\n*Triggered by:* {{ $('GitHub Webhook').item.json.body.workflow_run.triggering_actor.login }}\n*Run:* <{{ $('GitHub Webhook').item.json.body.workflow_run.html_url }}|View Run>"
            }
          ]
        }
      }
    },
    {
      "id": "f6a7b8c9-0006-4000-8000-600000000005",
      "name": "Send Slack Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [1200, 200],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "channel": "engineering-alerts",
        "text": "={{ $json.alertText }}",
        "otherOptions": {}
      },
      "credentials": {
        "slackApi": { "id": "3", "name": "Slack Bot Account" }
      }
    }
  ],
  "connections": {
    "GitHub Webhook": {
      "main": [
        [{ "node": "Check Workflow Completed", "type": "main", "index": 0 }]
      ]
    },
    "Check Workflow Completed": {
      "main": [
        [{ "node": "Check Run Failed", "type": "main", "index": 0 }],
        []
      ]
    },
    "Check Run Failed": {
      "main": [
        [{ "node": "Build Alert Message", "type": "main", "index": 0 }],
        []
      ]
    },
    "Build Alert Message": {
      "main": [
        [{ "node": "Send Slack Alert", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true
  }
}
