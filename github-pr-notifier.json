{
  "name": "GitHub PR Notifier",
  "nodes": [
    {
      "id": "e5f6a7b8-0005-4000-8000-500000000001",
      "name": "GitHub Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "github-pr-notifier",
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "github-pr-notifier-webhook"
    },
    {
      "id": "e5f6a7b8-0005-4000-8000-500000000002",
      "name": "Filter Opened or Merged",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.body.action }}",
              "rightValue": "opened",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "or"
        }
      }
    },
    {
      "id": "e5f6a7b8-0005-4000-8000-500000000003",
      "name": "Filter Merged",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 500],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.body.action }}",
              "rightValue": "closed",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "leftValue": "={{ $json.body.pull_request.merged }}",
              "rightValue": "true",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "e5f6a7b8-0005-4000-8000-500000000004",
      "name": "Notify PR Opened",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [740, 200],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "channel": "engineering",
        "text": "=:arrow_heading_up: *New PR Opened*\n*<{{ $('GitHub Webhook').item.json.body.pull_request.html_url }}|{{ $('GitHub Webhook').item.json.body.pull_request.title }}>*\nBy *{{ $('GitHub Webhook').item.json.body.pull_request.user.login }}* in `{{ $('GitHub Webhook').item.json.body.repository.full_name }}`\n+{{ $('GitHub Webhook').item.json.body.pull_request.additions }} / -{{ $('GitHub Webhook').item.json.body.pull_request.deletions }} lines",
        "otherOptions": {}
      },
      "credentials": {
        "slackApi": { "id": "3", "name": "Slack Bot Account" }
      }
    },
    {
      "id": "e5f6a7b8-0005-4000-8000-500000000005",
      "name": "Notify PR Merged",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [740, 480],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "channel": "engineering",
        "text": "=:merged: *PR Merged*\n*<{{ $('GitHub Webhook').item.json.body.pull_request.html_url }}|{{ $('GitHub Webhook').item.json.body.pull_request.title }}>*\nMerged by *{{ $('GitHub Webhook').item.json.body.pull_request.merged_by.login }}* into `{{ $('GitHub Webhook').item.json.body.pull_request.base.ref }}`",
        "otherOptions": {}
      },
      "credentials": {
        "slackApi": { "id": "3", "name": "Slack Bot Account" }
      }
    }
  ],
  "connections": {
    "GitHub Webhook": {
      "main": [
        [
          { "node": "Filter Opened or Merged", "type": "main", "index": 0 },
          { "node": "Filter Merged", "type": "main", "index": 0 }
        ]
      ]
    },
    "Filter Opened or Merged": {
      "main": [
        [{ "node": "Notify PR Opened", "type": "main", "index": 0 }],
        []
      ]
    },
    "Filter Merged": {
      "main": [
        [{ "node": "Notify PR Merged", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true
  }
}
