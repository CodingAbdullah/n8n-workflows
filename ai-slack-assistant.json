{
  "name": "AI Slack Assistant",
  "nodes": [
    {
      "id": "b2c3d4e5-0002-4000-8000-200000000001",
      "name": "Slack Trigger",
      "type": "n8n-nodes-base.slackTrigger",
      "typeVersion": 1,
      "position": [240, 300],
      "parameters": {
        "trigger": "app_mention"
      },
      "credentials": {
        "slackApi": { "id": "3", "name": "Slack Bot Account" }
      },
      "webhookId": "slack-ai-assistant-webhook"
    },
    {
      "id": "b2c3d4e5-0002-4000-8000-200000000002",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [480, 300],
      "parameters": {
        "mode": "manual",
        "fields": {
          "values": [
            {
              "name": "userMessage",
              "type": "string",
              "value": "={{ $json.event.text.replace(/<@[A-Z0-9]+>/g, '').trim() }}"
            },
            {
              "name": "channelId",
              "type": "string",
              "value": "={{ $json.event.channel }}"
            },
            {
              "name": "threadTs",
              "type": "string",
              "value": "={{ $json.event.thread_ts ?? $json.event.ts }}"
            }
          ]
        }
      }
    },
    {
      "id": "b2c3d4e5-0002-4000-8000-200000000003",
      "name": "Ask OpenAI",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [720, 300],
      "parameters": {
        "operation": "message",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a helpful assistant integrated into Slack. Respond concisely and use Slack-compatible markdown formatting where appropriate."
            },
            {
              "role": "user",
              "content": "={{ $json.userMessage }}"
            }
          ]
        },
        "options": {
          "maxTokens": 500,
          "temperature": 0.7
        }
      },
      "credentials": {
        "openAiApi": { "id": "2", "name": "OpenAI Account" }
      }
    },
    {
      "id": "b2c3d4e5-0002-4000-8000-200000000004",
      "name": "Reply in Thread",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [960, 300],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "channel": "={{ $('Build Prompt').item.json.channelId }}",
        "text": "={{ $json.message.content }}",
        "otherOptions": {
          "thread_ts": "={{ $('Build Prompt').item.json.threadTs }}"
        }
      },
      "credentials": {
        "slackApi": { "id": "3", "name": "Slack Bot Account" }
      }
    }
  ],
  "connections": {
    "Slack Trigger": {
      "main": [
        [{ "node": "Build Prompt", "type": "main", "index": 0 }]
      ]
    },
    "Build Prompt": {
      "main": [
        [{ "node": "Ask OpenAI", "type": "main", "index": 0 }]
      ]
    },
    "Ask OpenAI": {
      "main": [
        [{ "node": "Reply in Thread", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true
  }
}
