{
  "name": "AI Email Summarizer",
  "nodes": [
    {
      "id": "a1b2c3d4-0001-4000-8000-100000000001",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1,
      "position": [240, 300],
      "parameters": {
        "pollTimes": {
          "item": [{ "mode": "everyMinute" }]
        },
        "filters": {}
      },
      "credentials": {
        "gmailOAuth2": { "id": "1", "name": "Gmail Account" }
      }
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-100000000002",
      "name": "Summarize with OpenAI",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [500, 300],
      "parameters": {
        "operation": "message",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "messages": {
          "values": [
            {
              "role": "user",
              "content": "=Summarize the following email in 3 concise bullet points. Focus on action items and key information.\n\nFrom: {{ $json.from.value[0].address }}\nSubject: {{ $json.subject }}\n\n{{ $json.text }}"
            }
          ]
        },
        "options": {
          "maxTokens": 300,
          "temperature": 0.3
        }
      },
      "credentials": {
        "openAiApi": { "id": "2", "name": "OpenAI Account" }
      }
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-100000000003",
      "name": "Send Summary Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [760, 300],
      "parameters": {
        "operation": "send",
        "sendTo": "={{ $('Gmail Trigger').item.json.from.value[0].address }}",
        "subject": "=AI Summary: {{ $('Gmail Trigger').item.json.subject }}",
        "emailType": "text",
        "message": "=Here is a summary of the email you received:\n\n{{ $json.message.content }}\n\n---\nOriginal subject: {{ $('Gmail Trigger').item.json.subject }}"
      },
      "credentials": {
        "gmailOAuth2": { "id": "1", "name": "Gmail Account" }
      }
    }
  ],
  "connections": {
    "Gmail Trigger": {
      "main": [
        [{ "node": "Summarize with OpenAI", "type": "main", "index": 0 }]
      ]
    },
    "Summarize with OpenAI": {
      "main": [
        [{ "node": "Send Summary Email", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true
  }
}
