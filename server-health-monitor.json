{
  "name": "Server Health Monitor",
  "nodes": [
    {
      "id": "b8c9d0e1-0008-4000-8000-800000000001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [
            { "field": "minutes", "minutesInterval": 5 }
          ]
        }
      }
    },
    {
      "id": "b8c9d0e1-0008-4000-8000-800000000002",
      "name": "Define Target URLs",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [480, 300],
      "parameters": {
        "mode": "manual",
        "fields": {
          "values": [
            {
              "name": "targets",
              "type": "array",
              "value": [
                { "name": "Main API", "url": "https://api.example.com/health" },
                { "name": "Dashboard", "url": "https://dashboard.example.com" },
                { "name": "Auth Service", "url": "https://auth.example.com/ping" },
                { "name": "CDN", "url": "https://cdn.example.com/health" }
              ]
            }
          ]
        }
      }
    },
    {
      "id": "b8c9d0e1-0008-4000-8000-800000000003",
      "name": "Split Targets",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [720, 300],
      "parameters": {
        "fieldToSplitOut": "targets",
        "options": {}
      }
    },
    {
      "id": "b8c9d0e1-0008-4000-8000-800000000004",
      "name": "Ping Each URL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [960, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "options": {
          "timeout": 10000,
          "redirect": {
            "redirect": {
              "followRedirects": true,
              "maxRedirects": 3
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "b8c9d0e1-0008-4000-8000-800000000005",
      "name": "Check for Failures",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1200, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": { "type": "number", "operation": "notEquals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "b8c9d0e1-0008-4000-8000-800000000006",
      "name": "Alert Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [1440, 200],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "channel": "engineering-alerts",
        "text": "=:rotating_light: *Server Health Alert*\n*Service:* {{ $('Split Targets').item.json.name }}\n*URL:* {{ $('Split Targets').item.json.url }}\n*Status:* {{ $json.statusCode ?? 'Unreachable (timeout or connection error)' }}\n*Time:* {{ new Date().toUTCString() }}",
        "otherOptions": {}
      },
      "credentials": {
        "slackApi": { "id": "3", "name": "Slack Bot Account" }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [{ "node": "Define Target URLs", "type": "main", "index": 0 }]
      ]
    },
    "Define Target URLs": {
      "main": [
        [{ "node": "Split Targets", "type": "main", "index": 0 }]
      ]
    },
    "Split Targets": {
      "main": [
        [{ "node": "Ping Each URL", "type": "main", "index": 0 }]
      ]
    },
    "Ping Each URL": {
      "main": [
        [{ "node": "Check for Failures", "type": "main", "index": 0 }]
      ]
    },
    "Check for Failures": {
      "main": [
        [{ "node": "Alert Slack", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true
  }
}
